      "parameters": {
        "jsCode": "const docs = [\n  { title: \"Refund policy\", content: \"Customers can request a full refund within 30 days of purchase. After 30 days, refunds are issued as account credit. Refunds are processed within 5 business days.\" },\n  { title: \"Reset password\", content: \"To reset a password, click Forgot password on the login page and enter your email. A reset link is sent and stays valid for 1 hour. If no email arrives, check spam or contact support.\" },\n  { title: \"Shipping times\", content: \"Standard shipping takes 3-5 business days. Express shipping takes 1-2 business days. Orders placed after 2pm ship the next business day. Tracking numbers are emailed once the order ships.\" },\n  { title: \"Cancel subscription\", content: \"Subscriptions can be cancelled anytime under Account > Billing > Cancel plan. Access continues until the end of the paid period. No partial refunds are given for unused time.\" },\n  { title: \"Contact hours\", content: \"Support is available Monday to Friday, 9am to 6pm IST, by email and live chat. Priority customers also get phone support. Average first response time is under 2 hours.\" }\n];\nreturn docs.map(d => ({ json: { text: d.title + \": \" + d.content } }));"
      },
